{
  "name": "@wirexapp/viem-transport",
  "version": "1.0.0",
  "description": "Viem transport for Tron blockchain - enables Ethereum-compatible RPC calls on Tron via TronWeb",
  "source": "src/tronWeb/index.ts",
  "main": "dist/index.js",
  "types": "dist/tronWeb/tronWeb/index.d.ts",
  "publishConfig": {
    "access": "restricted"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "tron",
    "tronweb",
    "viem",
    "ethereum",
    "blockchain",
    "rpc",
    "transport",
    "safe",
    "gnosis-safe"
  ],
  "scripts": {
    "build": "rm -rf dist && microbundle --tsconfig tsconfig.json --no-sourcemap",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run --config vitest.config.unit.ts",
    "test:unit:watch": "vitest --config vitest.config.unit.ts",
    "test:unit:coverage": "vitest run --config vitest.config.unit.ts --coverage",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:integration:watch": "vitest --config vitest.config.integration.ts",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:e2e:watch": "vitest --config vitest.config.e2e.ts",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "example:basic": "tsx examples/basic/tronweb-demo.ts",
    "example:events": "tsx tests/integration/transport-events.test.ts",
    "example:advanced": "tsx tests/e2e/advanced.test.ts",
    "utils:conversion": "tsx tests/utils/conversion-test.ts",
    "utils:debug-events": "tsx tests/utils/debug-events.ts"
  },
  "author": "BOBER3r",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/BOBER3r/viem-transport.git"
  },
  "bugs": {
    "url": "https://github.com/BOBER3r/viem-transport/issues"
  },
  "homepage": "https://github.com/BOBER3r/viem-transport#readme",
  "dependencies": {
    "@safe-global/protocol-kit": "^6.1.1",
    "@safe-global/safe-ethers-lib": "^1.9.4",
    "bottleneck": "^2.19.5",
    "dotenv": "^17.2.2",
    "ethers": "^5.8.0",
    "p-retry": "^7.0.0",
    "tronweb": "^6.0.4",
    "viem": "^2.37.8"
  },
  "devDependencies": {
    "@vitest/ui": "^3.2.4",
    "microbundle": "^0.15.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
